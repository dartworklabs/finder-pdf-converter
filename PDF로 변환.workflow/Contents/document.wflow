				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># The session owns progress, cancellation, per-file results and failed-only retry.
workflow="$HOME/Library/Services/PDF로 변환.workflow"
source="$workflow/Contents/Resources"
fpdf_locale=en
title='PDF Conversion Results'
button='OK'
if [ -r "$source/locale.sh" ]; then
  . "$source/locale.sh"
  fpdf_locale=$(fpdf_language "$source/preferred-language.js")
  title=$(fpdf_text title)
  button=$(fpdf_text ok)
fi
# Startup errors are the only alerts this wrapper presents.
show_startup_error() {
  printf '%s\n' "$1" &gt;&amp;2
  /usr/bin/osascript -e 'on run argv
    display dialog (item 1 of argv) with title (item 2 of argv) buttons {(item 3 of argv)} default button (item 3 of argv)
  end run' "$1" "$title" "$button" &gt;/dev/null 2&gt;&amp;1 || true
}
if [ ! -f "$source/conversion-session.sh" ] || [ ! -r "$source/locale.sh" ]; then
  message='The PDF converter could not be found. Reinstall the Quick Action.'
  if [ -r "$source/locale.sh" ]; then message=$(fpdf_text missing_converter); fi
  show_startup_error "$message"
  exit 2
fi
/bin/bash "$source/conversion-session.sh" -- "$@"
status=$?
# File failures and cancellation were already presented by the session.
if [ "$status" -eq 1 ] || [ "$status" -eq 130 ]; then exit 0; fi
if [ "$status" -eq 2 ]; then show_startup_error "$(fpdf_text launch_failed "$status")"; fi
exit "$status"</string>
					<key>CheckedForUserDefaultShell</key>
