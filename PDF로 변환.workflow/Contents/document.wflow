				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Run the installed copy and show its summary from Finder.
workflow="$HOME/Library/Services/PDF로 변환.workflow"
source="$workflow/Contents/Resources"
# English is the fallback if the shared language resources are missing.
fpdf_locale=en
if [ -r "$source/locale.sh" ]; then
  . "$source/locale.sh"
  fpdf_locale=$(fpdf_language "$source/preferred-language.js")
  title=$(fpdf_text title)
  button=$(fpdf_text ok)
else
  title='PDF Conversion Results'
  button='OK'
fi
if [ ! -f "$source/convert.sh" ] || [ ! -r "$source/locale.sh" ]; then
  if [ -r "$source/locale.sh" ]; then
    summary=$(fpdf_text missing_converter)
  else
    summary='The PDF converter could not be found. Reinstall the Quick Action.'
  fi
  status=2
else
  summary=$(/bin/bash "$source/convert.sh" --no-dialog "$@" 2&gt;&amp;1)
  status=$?
fi
if [ -z "$summary" ]; then
  summary=$(fpdf_text launch_failed "$status")
fi
# Keep potentially large result text out of the process argument list.
if ! printf '%s' "$summary" | /usr/bin/osascript -l JavaScript -e '
ObjC.import("Foundation");
ObjC.import("AppKit");
/** Display UTF-8 result data from stdin with trusted localized UI labels. */
function run(argv) {
  const data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
  const message = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding));
  const app = $.NSApplication.sharedApplication;
  app.setActivationPolicy($.NSApplicationActivationPolicyRegular);
  const alert = $.NSAlert.alloc.init;
  alert.messageText = argv[0];
  alert.informativeText = message;
  alert.addButtonWithTitle(argv[1]);
  app.activateIgnoringOtherApps(true);
  alert.runModal;
}
' "$title" "$button"
then
  printf '%s\n' "$summary" &gt;&amp;2
  exit 1
fi
exit 0</string>
					<key>CheckedForUserDefaultShell</key>
